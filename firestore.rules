rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Posts collection: Public read, open write for CMS editing
    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Categories taxonomy: Public read, open write for CMS editing
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Authors collection: Public read, open write for CMS editing
    match /authors/{authorId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Subscribers collection: Public create for newsletter signups, read/write for admin
    match /subscribers/{subscriberId} {
      allow read, write: if true;
    }
    
    // Site settings: Public read, write for configuration
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }
  }
}
